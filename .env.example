# ==============================================================================
# BUDDY — Environment Configuration
# ==============================================================================

# Ollama LLM Server Settings
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=gemma4:e4b

# Server Networking
HOST=127.0.0.1
PORT=8000

# Performance & Hardware Settings
