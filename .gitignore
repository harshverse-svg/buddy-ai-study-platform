# ==============================================================================
# BUDDY - Production & Hackathon .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Configurations & Local Secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.cert

# Local Database & Dynamic Storage (Keep demo files and directory structures)
backend/storage/*.db
backend/storage/*.db-wal
backend/storage/*.db-shm
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/markdown/*
!backend/storage/markdown/.gitkeep
!backend/storage/markdown/ml_foundations.md

# IDE & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Files
*.log
logs/
temp/
tmp/
backend/cd/
